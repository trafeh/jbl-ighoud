--- !u!114 &144291263
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 144291261}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#F6C878><b><size=22>[ ROCK 1 - SILEX (FLINT) ]</size></b></color>\n<color=#9EAFC2><size=12>MIDDLE
    PALEOLITHIC \u2022 ~300,000 BP\nJBEL IGHOUD SITE, MOROCCO</size></color>\n\n<color=#384354>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\n\n<b>SPECIMEN
    ANALYSIS:</b>\n\n\u2022 <b>Mohs Hardness:</b> <color=#F6C878>20.0</color> / 20.0\n\u2022
    <b>Classification:</b> 15-20 (Extremely Hard/Tool Core)\n\u2022 <b>Toughness:</b>
    0.75\n\u2022 <b>Durability:</b> 5 / 5 Strikes\n\u2022 <b>Weight / Mass:</b> 1.4
    kg\n\u2022 <b>Prehistoric Role:</b> <color=#89D99D>Hammerstone \u2022 KnappableCore</color>\n\n<color=#384354>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\n\n<b>ARCHAEOLOGICAL
    DISCOVERY:</b>\nCentral to the landmark <i>Homo sapiens</i> (~315,000 BP) lithic
    industry at Jbel Ighoud. Deliberately knapped Levallois cores struck to produce
    razor-sharp triangular points and spear blades.\n\n<color=#64748B><size=11>\u2022
    Drag with touch / mouse to rotate in 3D\n\u2022 Scroll wheel to zoom</size></color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
