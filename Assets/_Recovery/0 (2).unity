  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#F6C878><b><size=22>[ ROCK 1 - SILEX (FLINT) (FRAGMENT) ]</size></b></color>\n<color=#9EAFC2><size=12>MIDDLE
    PALEOLITHIC \u2022 ~300,000 BP\nJBEL IGHOUD SITE, MOROCCO</size></color>\n\n<color=#384354>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\n\n<b>SPECIMEN
    ANALYSIS:</b>\n\n\u2022 <b>Mohs Hardness:</b> <color=#F6C878>20.0</color> / 20.0\n\u2022
    <b>Classification:</b> 15-20 (Extremely Hard/Tool Core)\n\u2022 <b>Toughness:</b>
    0.75\n\u2022 <b>Durability:</b> 5 / 5 Strikes\n\u2022 <b>Specimen Mass:</b> <color=#F6C878>1.4
    kg</color>\n\u2022 <b>Satchel Load:</b> 0.0 / 200.0 kg\n\u2022 <b>Prehistoric
    Role:</b> <color=#89D99D>Hammerstone \u2022 KnappableCore</color>\n\n<color=#384354>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\n\n<b>ARCHAEOLOGICAL
    DISCOVERY:</b>\nCentral to the landmark <i>Homo sapiens</i> (~315,000 BP) lithic
    industry at Jbel Ighoud. Deliberately knapped Levallois cores struck to produce
    razor-sharp triangular points and spear blades.\n\n<color=#64748B><size=11>\u2022
    Drag with touch / mouse to rotate in 3D\n\u2022 Scroll wheel to zoom</size></color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
